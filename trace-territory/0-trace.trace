{"type":"frame-snapshot","snapshot":{"callId":"call@2899","snapshotName":"after@call@2899","pageId":"page@f0051ce72f1fa7cf396d53f4dec368e5","frameId":"frame@666d390f26d26493df5b5754bede5251","frameUrl":"http://127.0.0.1:5173/","doctype":"html","html":["HTML",{"lang":"vi"},["HEAD",{},["BASE",{"href":"http://127.0.0.1:5173/"}],"\n    ","\n\n    ","\n\n    ",["META",{"charset":"utf-8"}],"\n    ",["META",{"name":"viewport","content":"width=device-width, initial-scale=1.0"}],"\n    ",["META",{"name":"theme-color","content":"#102238"}],"\n    ",["LINK",{"rel":"manifest","href":"/manifest.webmanifest"}],"\n    ",["TITLE",{},"Kingdoms of Meridian"],"\n  ",["STYLE",{},"/* Kingdoms of Meridian — design tokens.\r\n *\r\n * Two layers, and the split is load-bearing:\r\n *\r\n *   1. PALETTE — the only place in the client where a colour literal may appear.\r\n *   2. SEMANTIC — everything else, defined purely as var() references.\r\n *\r\n * `ui-primitives.test.ts` fails if a colour literal appears after the PALETTE\r\n * END marker. That is what stops one hex from drifting into three different\r\n * names, which is how design systems rot.\r\n *\r\n * Map colours are deliberately absent. The Pixi renderer hands numeric literals\r\n * (0x21423f) straight to the GPU and cannot read CSS variables, so terrain and\r\n * entity colours stay in `map.ts`. UI and map palettes are separate by\r\n * construction here, not by convention.\r\n */\r\n:root {\r\n  /* ── PALETTE BEGIN ──────────────────────────────────────────────────────\r\n   * Every value below is taken from the shipped UI, so adopting a token is a\r\n   * rename and never a repaint. Only the violet steps are new: espionage had\r\n   * exactly one colour before and needed a full ramp. */\r\n\r\n  /* Ink — the charcoal command tent everything sits in. */\r\n  --kom-ink-900: #0d1b2e;\r\n  --kom-ink-850: #0e1b2d;\r\n  --kom-ink-800: #102238;\r\n  --kom-ink-700: #1b3854;\r\n  /* The context column is ink-900 at 96%: the map has to stay faintly visible\r\n   * behind it, which is the one place a surface is deliberately translucent. */\r\n  --kom-ink-900-veil: rgba(13, 27, 46, .96);\r\n\r\n  /* Mist — cool blue-white, the existing reading text. */\r\n  --kom-mist-50: #f4f7fb;\r\n  --kom-mist-200: #cfe0f0;\r\n  --kom-mist-300: #c6d3df;\r\n  --kom-mist-400: #9fb8d1;\r\n\r\n  /* Parchment — warm accent text for titles and brass surfaces. */\r\n  --kom-parchment-100: #f2e6cd;\r\n  --kom-parchment-300: #d9c9a8;\r\n  --kom-parchment-500: #a89372;\r\n\r\n  /* Slate — neutral, NPC, borders, and informational notices. */\r\n  --kom-slate-100: #dcefff;\r\n  --kom-slate-300: #a9bfd5;\r\n  --kom-slate-400: #8fb0d0;\r\n  --kom-slate-500: #45617d;\r\n  --kom-slate-600: #3d7fa8;\r\n  --kom-slate-800: #1b4a6b;\r\n\r\n  /* Brass — primary, and the player's own holdings. */\r\n  --kom-brass-200: #ffe9a3;\r\n  --kom-brass-400: #f0d15a;\r\n  --kom-brass-500: #d8963f;\r\n  --kom-brass-800: #8a6d3b;\r\n  --kom-brass-ink: #092034;\r\n  --kom-brass-tint: rgba(240, 209, 90, .14);\r\n\r\n  /* Teal — allied, and success. */\r\n  --kom-teal-200: #9be3b8;\r\n  --kom-teal-400: #4caf7d;\r\n  --kom-teal-600: #7fa28f;\r\n  --kom-teal-800: #1e5631;\r\n  --kom-teal-tint: rgba(76, 175, 125, .18);\r\n\r\n  /* Amber — warning. */\r\n  --kom-amber-200: #ffd7a1;\r\n  --kom-amber-400: #ffb03a;\r\n  --kom-amber-tint: rgba(255, 176, 58, .15);\r\n\r\n  /* Ember — deeper orange, reserved for conditions that stop play entirely\r\n   * (a protocol mismatch) so they never read as an ordinary warning. */\r\n  --kom-ember-200: #ffe0c2;\r\n  --kom-ember-300: #ff9d66;\r\n  --kom-ember-400: #ff8f5c;\r\n  --kom-ember-900: rgba(92, 40, 8, .94);\r\n\r\n  /* Crimson — hostile, rejected, frozen. */\r\n  --kom-crimson-100: #ffe3dd;\r\n  --kom-crimson-200: #ffd2d2;\r\n  --kom-crimson-250: #ffb3a7;\r\n  --kom-crimson-350: #ff7676;\r\n  --kom-crimson-400: #ff5c57;\r\n  --kom-crimson-600: #b03a3a;\r\n  --kom-crimson-800: #6b292b;\r\n  --kom-crimson-900: rgba(116, 24, 35, .92);\r\n  --kom-crimson-900-soft: rgba(116, 24, 35, .55);\r\n  --kom-crimson-tint: rgba(255, 92, 87, .16);\r\n\r\n  /* Violet — espionage. */\r\n  --kom-violet-200: #e2c4ff;\r\n  --kom-violet-400: #c26cff;\r\n  --kom-violet-900: rgba(56, 26, 82, .92);\r\n  --kom-violet-tint: rgba(194, 108, 255, .14);\r\n\r\n  /* Verdant — the gold-rush world event only. Kept as a palette entry rather\r\n   * than a loose literal; it is brighter than the rest of the system on\r\n   * purpose and is not for UI chrome. */\r\n  --kom-verdant-400: #7dff72;\n\n  /* City interior — terrain and masonry behind the painted building sprites. */\n  --kom-city-sky-900: #102b36;\n  --kom-city-grass-900: #173c32;\n  --kom-city-grass-700: #285b3d;\n  --kom-city-grass-500: #3e7750;\n  --kom-city-earth-600: #80613b;\n  --kom-city-stone-300: #c5b58c;\n  --kom-city-stone-600: #76684c;\n\r\n  /* Neutral washes. Layering over ink is what gives panels depth without\r\n   * gradients, so these carry real weight in the visual language. */\r\n  --kom-wash-light-05: rgba(255, 255, 255, .05);\r\n  --kom-wash-light-06: rgba(255, 255, 255, .06);\r\n  --kom-wash-light-08: rgba(255, 255, 255, .08);\r\n  --kom-wash-light-12: rgba(255, 255, 255, .12);\r\n  --kom-wash-dark-20: rgba(0, 0, 0, .2);\r\n  --kom-wash-dark-25: rgba(0, 0, 0, .25);\r\n  --kom-wash-dark-40: rgba(0, 0, 0, .4);\r\n  --kom-wash-scrim: rgba(2, 8, 16, .66);\n\n  /* Cosmetic presentation colors. */\n  --kom-cosmetic-frame-meridian: #2b8fa3;\n  --kom-cosmetic-frame-sentinel: #77879a;\n  --kom-cosmetic-frame-ring: rgba(240, 209, 122, .7);\n  --kom-cosmetic-sentinel-ring: rgba(196, 109, 77, .7);\n  --kom-cosmetic-brass: #e3bd6b;\n  --kom-cosmetic-slate: #b8c3d0;\n  --kom-minimap-bg: rgba(22, 35, 38, .92);\n  --kom-minimap-border: rgba(240, 209, 122, .45);\n\r\n  /* ── PALETTE END ─────────────────────────────────────────────────────── */\r\n\r\n  /* Surfaces. Four opaque steps only: the app floor, the chrome around it, a\r\n   * panel, and something raised on top of a panel. More steps than that and\r\n   * panels stop reading as a hierarchy. The rail and the context column are the\r\n   * shell's two darker floors, and the three washes are lifts applied *over*\r\n   * whatever they sit on rather than surfaces of their own. */\r\n  --kom-bg-app: var(--kom-ink-850);\r\n  --kom-bg-chrome: var(--kom-ink-800);\r\n  --kom-bg-rail: var(--kom-ink-900);\r\n  --kom-bg-context: var(--kom-ink-900-veil);\r\n  --kom-surface: var(--kom-wash-dark-20);\r\n  --kom-surface-sunken: var(--kom-wash-dark-25);\r\n  --kom-surface-raised: var(--kom-ink-700);\r\n  --kom-surface-wash: var(--kom-wash-light-05);\r\n  --kom-surface-hover: var(--kom-wash-light-06);\r\n  --kom-surface-chip: var(--kom-wash-light-12);\r\n\r\n  /* Borders. `subtle` divides content inside a panel; `strong` separates one\r\n   * region of the shell from another. */\r\n  --kom-border-subtle: var(--kom-wash-light-08);\r\n  --kom-border-strong: var(--kom-slate-500);\r\n  --kom-border-accent: var(--kom-brass-800);\r\n\r\n  /* Text. */\r\n  --kom-text: var(--kom-mist-50);\r\n  --kom-text-heading: var(--kom-mist-200);\r\n  --kom-text-body: var(--kom-mist-300);\r\n  --kom-text-hint: var(--kom-mist-400);\r\n  --kom-text-muted: var(--kom-slate-300);\r\n  --kom-text-link: var(--kom-slate-400);\r\n  --kom-text-accent: var(--kom-parchment-100);\r\n  --kom-text-accent-dim: var(--kom-parchment-500);\r\n\r\n  /* Allegiance. These six are the game's vocabulary, not decoration: a player\r\n   * should be able to read allegiance off a chip without its label. */\r\n  --kom-primary: var(--kom-brass-400);\r\n  --kom-primary-soft: var(--kom-brass-200);\r\n  --kom-primary-deep: var(--kom-brass-500);\r\n  --kom-primary-tint: var(--kom-brass-tint);\r\n  --kom-on-primary: var(--kom-brass-ink);\r\n  --kom-allied: var(--kom-teal-400);\r\n  --kom-allied-soft: var(--kom-teal-200);\r\n  --kom-allied-muted: var(--kom-teal-600);\r\n  --kom-allied-deep: var(--kom-teal-800);\r\n  --kom-allied-tint: var(--kom-teal-tint);\r\n  --kom-hostile: var(--kom-crimson-400);\r\n  --kom-hostile-soft: var(--kom-crimson-250);\r\n  --kom-hostile-deep: var(--kom-crimson-600);\r\n  --kom-hostile-tint: var(--kom-crimson-tint);\r\n  --kom-on-hostile: var(--kom-crimson-100);\r\n  --kom-espionage: var(--kom-violet-400);\r\n  --kom-espionage-soft: var(--kom-violet-200);\r\n  --kom-espionage-tint: var(--kom-violet-tint);\r\n  --kom-neutral: var(--kom-slate-400);\r\n  --kom-neutral-soft: var(--kom-slate-300);\r\n  --kom-scrim: var(--kom-wash-scrim);\r\n\r\n  /* Informational notice — the one notice kind that is not a game state. Slate\r\n   * so it never competes with success, warning or hostile for attention. */\r\n  --kom-info-fill: var(--kom-slate-800);\r\n  --kom-info-border: var(--kom-slate-600);\r\n  --kom-info-text: var(--kom-slate-100);\r\n\r\n  /* One supply signal, and no world-event accents. `--kom-event-boon` and\r\n   * `--kom-event-blight` were a third colour scheme for a single left rule on an\r\n   * event row: an event's severity is a `StatusChip` now, drawn from the same\r\n   * eight states as every other status in the UI, so the two accents left with\r\n   * the rule that was their only consumer. */\r\n  --kom-supply-low: var(--kom-ember-300);\n  --kom-city-sky: var(--kom-city-sky-900);\n  --kom-city-grass: var(--kom-city-grass-700);\n  --kom-city-grass-shadow: var(--kom-city-grass-900);\n  --kom-city-grass-light: var(--kom-city-grass-500);\n  --kom-city-earth: var(--kom-city-earth-600);\n  --kom-city-stone: var(--kom-city-stone-300);\n  --kom-city-stone-shadow: var(--kom-city-stone-600);\n\r\n  /* Semantic UI states. Each one is a fill/border/text triple so a chip, a\r\n   * banner and a panel accent can all express the same state consistently.\r\n   *\r\n   * `pending` and `uncertain` are deliberately different hues: pending is the\r\n   * server still thinking, which needs no action, while uncertain means the\r\n   * command may or may not have landed and the player must decide to retry.\r\n   * Collapsing them into one colour is how players end up double-issuing\r\n   * orders. `protocol-blocked` gets ember rather than amber because it stops\r\n   * every command, unlike a warning. */\r\n  --kom-state-pending-fill: var(--kom-surface-wash);\r\n  --kom-state-pending-border: var(--kom-slate-500);\r\n  --kom-state-pending-text: var(--kom-slate-300);\r\n  --kom-state-uncertain-fill: var(--kom-amber-tint);\r\n  --kom-state-uncertain-border: var(--kom-amber-400);\r\n  --kom-state-uncertain-text: var(--kom-amber-200);\r\n  --kom-state-rejected-fill: var(--kom-crimson-800);\r\n  --kom-state-rejected-border: var(--kom-crimson-350);\r\n  --kom-state-rejected-text: var(--kom-crimson-250);\r\n  --kom-state-frozen-fill: var(--kom-crimson-900);\r\n  --kom-state-frozen-border: var(--kom-crimson-350);\r\n  --kom-state-frozen-text: var(--kom-crimson-200);\r\n  --kom-state-protocol-blocked-fill: var(--kom-ember-900);\r\n  --kom-state-protocol-blocked-border: var(--kom-ember-400);\r\n  --kom-state-protocol-blocked-text: var(--kom-ember-200);\r\n  --kom-state-success-fill: var(--kom-teal-tint);\r\n  --kom-state-success-border: var(--kom-teal-400);\r\n  --kom-state-success-text: var(--kom-teal-200);\r\n  --kom-state-warning-fill: var(--kom-amber-tint);\r\n  --kom-state-warning-border: var(--kom-brass-500);\r\n  --kom-state-warning-text: var(--kom-amber-200);\r\n  --kom-state-hostile-fill: var(--kom-crimson-900-soft);\r\n  --kom-state-hostile-border: var(--kom-crimson-400);\r\n  --kom-state-hostile-text: var(--kom-crimson-250);\r\n\r\n  /* Spacing. 4px base with the 2px and 6px half-steps the dense panels need. */\r\n  --kom-space-1: 2px;\r\n  --kom-space-2: 4px;\r\n  --kom-space-3: 6px;\r\n  --kom-space-4: 8px;\r\n  --kom-space-5: 12px;\r\n  --kom-space-6: 16px;\r\n  --kom-space-7: 24px;\r\n\r\n  --kom-radius-sm: 8px;\r\n  --kom-radius-md: 10px;\r\n  --kom-radius-lg: 12px;\r\n  --kom-radius-xl: 16px;\r\n  --kom-radius-pill: 999px;\r\n\r\n  /* Depth comes from layering and a hairline top highlight, not gradients:\r\n   * `--kom-edge-highlight` is the 1px of catch-light along a panel's top edge\r\n   * that reads as beaten metal without a single gradient stop. */\r\n  --kom-edge-highlight: inset 0 1px 0 var(--kom-wash-light-06);\r\n  --kom-shadow-panel: 0 2px 10px var(--kom-wash-dark-20);\r\n  --kom-shadow-raised: 0 10px 26px var(--kom-wash-dark-40);\r\n  --kom-shadow-modal: 0 14px 40px var(--kom-wash-dark-40);\r\n\r\n  /* Typography. Inter is declared first but is NOT bundled — it renders only\r\n   * where the player already has it, and system-ui carries everyone else.\r\n   * Every step in the stack has full Vietnamese coverage (Segoe UI, SF,\r\n   * Roboto), which is why no webfont is fetched. */\r\n  --kom-font-ui: Inter, system-ui, sans-serif;\r\n  --kom-text-2xs: .68rem;\r\n  --kom-text-xs: .72rem;\r\n  --kom-text-sm: .78rem;\r\n  --kom-text-md: .82rem;\r\n  --kom-text-base: .88rem;\r\n  --kom-text-lg: 1rem;\r\n  --kom-text-xl: 1.25rem;\r\n  --kom-text-2xl: 1.6rem;\r\n  --kom-weight-regular: 400;\r\n  --kom-weight-medium: 600;\r\n  --kom-weight-bold: 700;\r\n  /* Both leadings stay at or above 1.2: stacked Vietnamese diacritics (ế, ự,\r\n   * Ỹ) clip against the line box below that, and the test enforces it. */\r\n  --kom-leading-tight: 1.25;\r\n  --kom-leading-normal: 1.45;\r\n\r\n  /* Motion. A strategy UI should feel deliberate, not springy; nothing here is\r\n   * long enough to delay a click's feedback past the ~100ms perception floor. */\r\n  --kom-motion-fast: 90ms;\r\n  --kom-motion-base: 160ms;\r\n  --kom-motion-slow: 260ms;\r\n  --kom-ease-out: cubic-bezier(.2, .7, .3, 1);\r\n\r\n  /* Stacking. The shell used bare integers 2–8; naming them means the Situation\r\n   * Room can add a layer without auditing every z-index in the file. */\r\n  --kom-z-map-overlay: 2;\r\n  --kom-z-chrome: 3;\r\n  --kom-z-banner: 5;\r\n  --kom-z-alert: 6;\r\n  --kom-z-toast: 7;\r\n  --kom-z-modal: 8;\r\n\r\n  --kom-focus-ring: 0 0 0 2px var(--kom-ink-850), 0 0 0 4px var(--kom-primary);\r\n  --kom-icon-sm: 14px;\r\n  --kom-icon-md: 18px;\r\n}\n/* Kingdoms of Meridian — UI primitives.\r\n *\r\n * Four things only: panel, button, status chip, icon, plus two typography\r\n * utilities. Everything reads from tokens.css; there are no literals here.\r\n *\r\n * Class names are mirrored in `ui/variants.ts` and the pairing is asserted by\r\n * `ui-primitives.test.ts`, so a typo in either file fails the build instead of\r\n * silently rendering an unstyled element.\r\n */\r\n\r\n/* ── PANEL ─────────────────────────────────────────────────────────────────\r\n * Depth is layering plus a 1px catch-light on the top edge. No gradients: a\r\n * gradient reads as glass, and this UI is meant to read as a lit map table. */\r\n.kom-panel {\r\n  --kom-panel-pad: var(--kom-space-5);\r\n  --kom-panel-accent: transparent;\r\n  display: flex;\r\n  flex-direction: column;\r\n  background: var(--kom-surface);\r\n  border: 1px solid var(--kom-border-subtle);\r\n  border-left: 3px solid var(--kom-panel-accent);\r\n  border-radius: var(--kom-radius-lg);\r\n  box-shadow: var(--kom-edge-highlight), var(--kom-shadow-panel);\r\n  color: var(--kom-text-body);\r\n  overflow: hidden;\r\n}\r\n.kom-panel--compact { --kom-panel-pad: var(--kom-space-4); }\r\n.kom-panel--flush { box-shadow: none; background: none; border-color: transparent; }\r\n\r\n.kom-panel--accent-brass { --kom-panel-accent: var(--kom-primary); }\r\n.kom-panel--accent-teal { --kom-panel-accent: var(--kom-allied); }\r\n.kom-panel--accent-amber { --kom-panel-accent: var(--kom-state-warning-border); }\r\n.kom-panel--accent-crimson { --kom-panel-accent: var(--kom-hostile); }\r\n.kom-panel--accent-violet { --kom-panel-accent: var(--kom-espionage); }\r\n.kom-panel--accent-slate { --kom-panel-accent: var(--kom-neutral); }\r\n\r\n.kom-panel__header {\r\n  display: flex;\r\n  align-items: baseline;\r\n  gap: var(--kom-space-4);\r\n  padding: var(--kom-panel-pad);\r\n  border-bottom: 1px solid var(--kom-border-subtle);\r\n}\r\n.kom-panel__heading {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: var(--kom-space-3);\r\n  margin: 0;\r\n  color: var(--kom-text-accent);\r\n  font-size: var(--kom-text-lg);\r\n  font-weight: var(--kom-weight-medium);\r\n  line-height: var(--kom-leading-tight);\r\n}\r\n.kom-panel__meta { color: var(--kom-text-hint); font-size: var(--kom-text-xs); }\r\n.kom-panel__actions { display: flex; gap: var(--kom-space-2); margin-left: auto; }\r\n.kom-panel__body { padding: var(--kom-panel-pad); display: flex; flex-direction: column; gap: var(--kom-space-4); }\r\n/* Body and footer are gap-based columns, so a paragraph inside them must not add\r\n * the UA's 1em block margins on top of the gap. Written as a descendant rule\r\n * rather than folded into `.kom-meta`, because that utility is also used inside\r\n * modal cards and rows that have no gap of their own to fall back on. */\r\n.kom-panel__body p, .kom-panel__footer p { margin: 0; }\r\n.kom-panel__footer {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: var(--kom-space-3);\r\n  flex-wrap: wrap;\r\n  padding: var(--kom-panel-pad);\r\n  border-top: 1px solid var(--kom-border-subtle);\r\n  background: var(--kom-surface-sunken);\r\n}\r\n/* ── BUTTON ────────────────────────────────────────────────────────────────\r\n * Padding matches the shipped `button` rule so migrating a button never moves\r\n * anything around it. */\r\n.kom-btn {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: var(--kom-space-3);\r\n  padding: 11px 12px;\r\n  border: 1px solid transparent;\r\n  border-radius: var(--kom-radius-md);\r\n  font: inherit;\r\n  font-size: var(--kom-text-sm);\r\n  font-weight: var(--kom-weight-bold);\r\n  line-height: var(--kom-leading-tight);\r\n  cursor: pointer;\r\n  transition: background var(--kom-motion-fast) var(--kom-ease-out),\r\n              border-color var(--kom-motion-fast) var(--kom-ease-out);\r\n}\r\n.kom-btn:focus-visible { outline: none; box-shadow: var(--kom-focus-ring); }\r\n.kom-btn--compact { padding: var(--kom-space-3) var(--kom-space-4); font-size: var(--kom-text-xs); }\r\n.kom-btn--block { width: 100%; }\r\n\r\n.kom-btn--primary { background: var(--kom-primary); color: var(--kom-on-primary); }\r\n.kom-btn--primary:hover:not(:disabled) { background: var(--kom-primary-soft); }\r\n.kom-btn--secondary { background: var(--kom-surface-raised); color: var(--kom-text); border-color: var(--kom-border-strong); }\r\n.kom-btn--secondary:hover:not(:disabled) { border-color: var(--kom-primary); }\r\n.kom-btn--ghost { background: none; color: var(--kom-text-link); }\r\n.kom-btn--ghost:hover:not(:disabled) { background: var(--kom-surface-hover); color: var(--kom-text); }\r\n.kom-btn--destructive { background: var(--kom-hostile-deep); color: var(--kom-on-hostile); }\r\n.kom-btn--destructive:hover:not(:disabled) { background: var(--kom-hostile); color: var(--kom-on-primary); }\r\n\r\n/* Disabled drops the fill entirely rather than fading it. A 45%-opacity brass\r\n * button is still brass-coloured and still looks pressable, and its text lands\r\n * near 3:1 against the panel; an unfilled dashed shape reads as gated at a\r\n * glance and keeps hint text at ~7:1.\r\n *\r\n * `opacity: 1` is not redundant: the shipped sheet still carries\r\n * `button:disabled { opacity: .45 }`, and a `.kom-btn` is a `button`. Without\r\n * this the two treatments would stack and fade the hint back below 3:1. */\r\n.kom-btn:disabled, .kom-btn--disabled {\r\n  background: var(--kom-surface-wash);\r\n  color: var(--kom-text-hint);\r\n  border: 1px dashed var(--kom-border-strong);\r\n  opacity: 1;\r\n  cursor: not-allowed;\r\n}\r\n/* A gate is the button plus the reason it cannot be pressed. A disabled button\r\n * is not focusable, so the reason has to be visible text — `aria-describedby`\r\n * alone would be announced to nobody. */\r\n.kom-btn-gate { display: inline-flex; flex-direction: column; gap: var(--kom-space-1); align-items: flex-start; }\r\n.kom-btn-reason { color: var(--kom-text-hint); font-size: var(--kom-text-xs); line-height: var(--kom-leading-normal); }\r\n/* ── STATUS ────────────────────────────────────────────────────────────────\r\n * One chip shape, eight states. Each state sets three locals so a banner or a\r\n * panel accent can reuse the same triple without redefining the colours. */\r\n.kom-status {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: var(--kom-space-3);\r\n  padding: var(--kom-space-2) var(--kom-space-4);\r\n  border: 1px solid var(--kom-status-border);\r\n  border-radius: var(--kom-radius-pill);\r\n  background: var(--kom-status-fill);\r\n  color: var(--kom-status-text);\r\n  font-size: var(--kom-text-xs);\r\n  font-weight: var(--kom-weight-bold);\r\n  line-height: var(--kom-leading-tight);\r\n  white-space: nowrap;\r\n}\r\n.kom-status__dot { width: 8px; height: 8px; border-radius: 50%; background: currentColor; flex: none; }\r\n.kom-status--block { display: flex; width: 100%; border-radius: var(--kom-radius-md); white-space: normal; }\r\n\r\n.kom-status--pending { --kom-status-fill: var(--kom-state-pending-fill); --kom-status-border: var(--kom-state-pending-border); --kom-status-text: var(--kom-state-pending-text); }\r\n.kom-status--uncertain { --kom-status-fill: var(--kom-state-uncertain-fill); --kom-status-border: var(--kom-state-uncertain-border); --kom-status-text: var(--kom-state-uncertain-text); }\r\n.kom-status--rejected { --kom-status-fill: var(--kom-state-rejected-fill); --kom-status-border: var(--kom-state-rejected-border); --kom-status-text: var(--kom-state-rejected-text); }\r\n.kom-status--frozen { --kom-status-fill: var(--kom-state-frozen-fill); --kom-status-border: var(--kom-state-frozen-border); --kom-status-text: var(--kom-state-frozen-text); }\r\n.kom-status--protocol-blocked { --kom-status-fill: var(--kom-state-protocol-blocked-fill); --kom-status-border: var(--kom-state-protocol-blocked-border); --kom-status-text: var(--kom-state-protocol-blocked-text); }\r\n.kom-status--success { --kom-status-fill: var(--kom-state-success-fill); --kom-status-border: var(--kom-state-success-border); --kom-status-text: var(--kom-state-success-text); }\r\n.kom-status--warning { --kom-status-fill: var(--kom-state-warning-fill); --kom-status-border: var(--kom-state-warning-border); --kom-status-text: var(--kom-state-warning-text); }\r\n.kom-status--hostile { --kom-status-fill: var(--kom-state-hostile-fill); --kom-status-border: var(--kom-state-hostile-border); --kom-status-text: var(--kom-state-hostile-text); }\r\n\r\n/* Only `pending` animates, and only because \"the server has not answered yet\"\r\n * is the one state where stillness is indistinguishable from a hung client. */\r\n.kom-status--pending .kom-status__dot { animation: kom-pulse var(--kom-motion-slow) var(--kom-ease-out) infinite alternate; }\r\n@keyframes kom-pulse { to { opacity: .35; } }\r\n@media (prefers-reduced-motion: reduce) {\r\n  .kom-status--pending .kom-status__dot { animation: none; }\r\n  .kom-btn { transition: none; }\r\n}\r\n\r\n/* ── ICON & TYPOGRAPHY ─────────────────────────────────────────────────────\r\n * Icons inherit colour so one glyph serves every semantic state. */\r\n.kom-icon { width: var(--kom-icon-md); height: var(--kom-icon-md); flex: none; }\r\n.kom-icon--sm { width: var(--kom-icon-sm); height: var(--kom-icon-sm); }\r\n/* Resource counters and countdowns retick every second; proportional digits\r\n * make the whole row shuffle sideways as they do. */\r\n.kom-num { font-variant-numeric: tabular-nums; }\r\n.kom-meta { color: var(--kom-text-hint); font-size: var(--kom-text-xs); line-height: var(--kom-leading-normal); }\n\n:root { font-family: var(--kom-font-ui); color: var(--kom-text); background: var(--kom-bg-app); font-synthesis: none; }\n* { box-sizing: border-box; }\nbody { margin: 0; min-width: 320px; }\nmain { height: 100vh; position: relative; overflow: hidden; }\n\n/* ── SITUATION ROOM SHELL ─────────────────────────────────────────────────────\n * Five areas: a header that never collapses, three columns, and a command tray.\n *\n *   header header header\n *   kingdom  map  activity\n *   tray   tray   tray\n *\n * The two side columns are variable-width tracks, and the variable is the whole\n * mechanism: `--kom-col-*` is 0 by default, a band promotes it to a real width,\n * and `situation-room--<id>-closed` puts it back to 0. So a column has three\n * states — flyout over the map, open track, collapsed track — and all three are\n * one declaration apart. Nothing is unmounted and nothing is absolutely\n * positioned, which is what keeps the map's own box the only thing Pixi has to\n * follow (see `layout.ts` for why the band lives in CSS and the open/closed\n * state lives in React).\n *\n * There is deliberately no transition on the track widths: animating them would\n * fire the map's ResizeObserver on every frame of the animation and re-lay out a\n * WebGL surface 60 times to save one instant of jump. */\n.situation-room {\n  height: 100%;\n  display: grid;\n  --kom-col-kingdom: 0px;\n  --kom-col-activity: 0px;\n  grid-template-columns: var(--kom-col-kingdom) minmax(0, 1fr) var(--kom-col-activity);\n  grid-template-rows: auto minmax(0, 1fr) auto;\n  grid-template-areas: \"header header header\" \"kingdom map activity\" \"tray tray tray\";\n}\n/* Doubled on purpose: (0,2,0) beats every single-class rule below, so a closed\n   column collapses in every band regardless of source order. */\n.situation-room.situation-room--kingdom-closed { --kom-col-kingdom: 0px; }\n.situation-room.situation-room--activity-closed { --kom-col-activity: 0px; }\n\n.strategic-header { grid-area: header; position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: var(--kom-space-4) var(--kom-space-5); min-height: 56px; padding: var(--kom-space-3) var(--kom-space-5); background: var(--kom-bg-chrome); border-bottom: 1px solid var(--kom-border-strong); z-index: var(--kom-z-chrome); }\n.strategic-header .brand { display: flex; flex-direction: column; gap: 2px; min-width: 0; }\n/* The page's one <h1> is the player's own kingdom, which is also the largest\n   thing the brand block ever said — so it is the same size it was as a <strong>.\n   Naming the level does not mean shouting it; the outline needs the element, the\n   header does not need 2rem of it. */\n.strategic-header .brand h1 { margin: 0; font-size: 1rem; line-height: 1.2; color: var(--kom-text-heading); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.strategic-header .brand span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n/* Faction and the way out, on one line under the name. The logout control used to\n   be a `.link-button` inside the ellipsised text, so a long faction name could\n   clip the only way to sign out; a flex row gives the button a size of its own\n   and lets the name lose characters instead. */\n.brand__line { display: flex; align-items: baseline; gap: var(--kom-space-2); min-width: 0; }\n.brand__line .kom-btn { flex: none; }\n.strategic-header .resource-grid { margin-left: auto; }\n.header-surfaces { display: flex; gap: var(--kom-space-2); }\n.header-toggle { color: var(--kom-text-muted); }\n/* The inset underline is what makes \"open\" readable without colour vision: tint\n   and text colour both change, but so does the shape of the control. */\n.header-toggle--on { color: var(--kom-primary); background: var(--kom-primary-tint); box-shadow: inset 0 -2px 0 currentColor; }\n.season { display: flex; align-items: center; gap: var(--kom-space-3); color: var(--kom-text-muted); font-size: .8rem; white-space: nowrap; }\n.season__score { display: inline-flex; align-items: center; gap: var(--kom-space-1); }\n.connection-pill { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px; font-size: .76rem; font-weight: 700; white-space: nowrap; }\n/* The connection pill is a state read three ways: the fill and text of a state\n   triple carry the pill, and its border step — the saturated one — is what an\n   8px dot needs to stay legible at that size. */\n.connection-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--kom-state-uncertain-border); }\n.conn-online .connection-dot { background: var(--kom-state-success-border); }\n.conn-reconnecting .connection-dot, .conn-connecting .connection-dot { background: var(--kom-state-uncertain-border); animation: conn-blink 1.1s steps(2, start) infinite; }\n.conn-offline .connection-dot { background: var(--kom-state-hostile-border); }\n@keyframes conn-blink { to { visibility: hidden; } }\n.conn-online { background: var(--kom-state-success-fill); color: var(--kom-state-success-text); }\n.conn-reconnecting, .conn-connecting { background: var(--kom-state-uncertain-fill); color: var(--kom-state-uncertain-text); }\n/* Offline takes a lighter wash than the hostile chip: this pill sits on the top\n   bar, where the chip's deeper blood fill would read as an attack, not a status. */\n.conn-offline { background: var(--kom-hostile-tint); color: var(--kom-state-hostile-text); }\n/* Anchored to the header rather than to a hard 62px, because the header is now an\n   `auto` row that gains a line when the resource grid wraps at narrow widths. */\n.frozen-banner { position: absolute; top: calc(100% + var(--kom-space-2)); left: 50%; transform: translateX(-50%); z-index: var(--kom-z-alert); max-width: min(92vw, 560px); padding: 8px 14px; border: 1px solid var(--kom-state-frozen-border); border-radius: 8px; color: var(--kom-state-frozen-text); background: var(--kom-state-frozen-fill); font-size: .82rem; text-align: center; }\n\n/* The old 64px rail, folded into the kingdom column's sticky head: a row of four\n   chips instead of a column of four, which hands the map back the 64px the rail\n   was holding.\n\n   `.kom-btn` rather than `button`, and `[aria-current]` rather than the\n   `.nav-active` class only this sheet understood: the chips are ghost `Button`s\n   now, so the open panel is marked in the accessibility tree first and tinted\n   second. (0,2,0) is what it takes to beat `.kom-btn--ghost`'s own colour. */\n.kingdom-nav { display: flex; gap: var(--kom-space-2); margin-top: var(--kom-space-3); }\n.kingdom-nav .kom-btn { flex: 1 1 0; min-width: 0; flex-direction: column; gap: 2px; padding: var(--kom-space-3) var(--kom-space-1); color: var(--kom-text-muted); border-radius: 10px; }\n.kingdom-nav .kom-btn[aria-current] { background: var(--kom-primary-tint); color: var(--kom-primary); }\n.nav-label { font-size: .6rem; font-weight: 700; letter-spacing: .01em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%; }\n\n.map { grid-area: map; position: relative; overflow: hidden; }\n.map canvas { position: absolute; inset: 0; transition: opacity 420ms ease, transform 420ms ease; }\n.map canvas[data-city-transition=\"entering\"] { opacity: .2; transform: scale(1.08); }\n@media (prefers-reduced-motion: reduce) {\n  .map canvas { transition: none; }\n}\n.protocol-banner { position: absolute; top: 12px; left: 50%; transform: translateX(-50%); z-index: var(--kom-z-banner); padding: 10px 16px; border: 1px solid var(--kom-state-protocol-blocked-border); border-radius: 10px; background: var(--kom-state-protocol-blocked-fill); color: var(--kom-state-protocol-blocked-text); font-size: .85rem; }\n\n/* Both side columns start life as flyouts: they share the map's grid cell, sit on\n   top of it at the chrome z-index, and pin to their own edge. A band promotes one\n   to a real track further down. Overlaying by grid area instead of by\n   `position: absolute` is what keeps the map's box — and so Pixi's viewport — the\n   single source of truth for how large the map is. */\n.kingdom-column, .activity-column { grid-area: map; z-index: var(--kom-z-chrome); width: min(320px, 100%); overflow-y: auto; overscroll-behavior: contain; background: var(--kom-bg-context); box-shadow: var(--kom-shadow-raised); }\n/* The column owns the rhythm between its panels. It used to be a `margin-top:\n   1rem` handed to each panel by the `.hud .kom-panel` bridge, which is why the\n   bridge could not be deleted while any surface still needed dressing; 16px is\n   `--kom-space-6`, the same gap, now declared once and in the same shape as the\n   activity column on the other side of the map. */\n.kingdom-column { justify-self: start; display: flex; flex-direction: column; gap: var(--kom-space-6); padding: 0 var(--kom-space-5) var(--kom-space-5); border-right: 1px solid var(--kom-border-strong); }\n.activity-column { justify-self: end; display: flex; flex-direction: column; gap: var(--kom-space-5); padding: var(--kom-space-5); border-left: 1px solid var(--kom-border-strong); }\n/* `[hidden]` is only a UA rule, so the author `display` above would beat it. */\n.kingdom-column[hidden], .activity-column[hidden] { display: none; }\n/* The city you are looking at and the jump chips are the column's own header, not\n   its first panel: they stay put while the panels scroll under them. */\n.kingdom-column__head { position: sticky; top: 0; z-index: 1; margin: 0 calc(var(--kom-space-5) * -1); padding: var(--kom-space-4) var(--kom-space-5) var(--kom-space-3); background: var(--kom-bg-rail); border-bottom: 1px solid var(--kom-border-strong); }\n/* Stacked, not the old baseline row: at 288px the city name and the subtitle\n   side by side left the name ~130px, so every second city wrapped to two lines\n   and the sticky head changed height with the city you were looking at. */\n.kingdom-column__head .hud-title { flex-direction: column; align-items: flex-start; gap: 0; }\n.kingdom-column__head .kom-status { margin-top: var(--kom-space-2); }\n/* `revealPanel` scrolls with `block: \"start\"`, which would tuck the target under\n   that sticky head without this. 118px clears the head measured in a browser at\n   the narrowest track (114px) — title, subtitle and the four nav chips. The\n   second selector is not a duplicate: the four panels a jump chip aims at are\n   children of the frozen fieldset now, not of the column, and a rule that only\n   knew the column would have quietly stopped clearing the head for all of them. */\n.kingdom-column > *, .kingdom-column__panels > * { scroll-margin-top: 118px; }\n/* Both columns are flex columns that scroll, and `.kom-panel` sets\n   `overflow: hidden` — which makes a panel's automatic minimum size 0, so every\n   panel was a shrinkable item in a container shorter than its content. The\n   browser did exactly what that asks: it squashed all of them to fit, the column's\n   `scrollHeight` came out equal to its `clientHeight` (nothing to scroll), and each\n   panel clipped its own content. A control below the fold was on the page,\n   measurable, and painted nowhere — which is how a click on it lands on the column\n   behind instead. Panels are content, not space to be distributed: `flex: none`\n   gives each its own height back and hands the overflow to the column, which is\n   the one box here that is meant to scroll. */\n.kingdom-column > *, .kingdom-column__panels > *, .activity-column > * { flex: none; }\n.hud-title { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }\n.hud-title h2 { margin: 0; }\n/* A fieldset, because `disabled` on one is the only thing in the platform that\n   disables every control inside it — which is what a frozen city means, and what\n   the old `.hud-frozen { pointer-events: none; opacity: .5 }` only pretended:\n   every button stayed in the tab order and stayed pressable by keyboard, and the\n   text behind that opacity fell under 3:1. `min-width: 0` undoes a fieldset's\n   `min-inline-size: min-content`, which would otherwise stop the 320px column\n   from shrinking to the flyout width. The disabled look comes from\n   `.kom-btn:disabled` in the primitives, so it is the same treatment as every\n   other blocked control and carries the same contrast. */\n.kingdom-column__panels { min-width: 0; margin: 0; padding: 0; border: 0; display: flex; flex-direction: column; gap: var(--kom-space-6); }\n\n/* Row 3: the contextual command area. The selection is its left half — the same\n   region with the same accessible name, moved out of a floating bar into a\n   full-width row so ordering a move no longer covers the tile being aimed at.\n   The right half was a reserved slot with a label in it; `tray-groups.ts` fills\n   it, and the label, its `display: none` and its promotion at 1024px went with\n   the emptiness they described.\n\n   Every rule below exists to keep this row exactly as tall as it was empty. The\n   tray shares a grid row with the map and the map's box is what Pixi sizes its\n   canvas from, so a second line here resizes the renderer. The table caps the\n   commands at four short labels, nothing wraps, and the three texts that can be\n   long shrink to an ellipsis instead of growing downward. */\n.command-tray { grid-area: tray; display: flex; align-items: stretch; min-height: 60px; background: var(--kom-bg-chrome); border-top: 1px solid var(--kom-border-strong); z-index: var(--kom-z-chrome); }\n.command-tray__context { flex: 1 1 auto; min-width: 0; display: flex; align-items: center; gap: var(--kom-space-5); padding: var(--kom-space-3) var(--kom-space-6); }\n.command-tray__context strong { white-space: nowrap; }\n.command-tray__detail { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--kom-text-hint); font-size: var(--kom-text-sm); }\n.command-tray__commands { flex: 0 1 auto; min-width: 0; display: flex; align-items: center; padding: var(--kom-space-3) var(--kom-space-6); border-left: 1px solid var(--kom-border-accent); }\n.command-tray__group { display: flex; align-items: center; gap: var(--kom-space-3); min-width: 0; }\n.command-tray__group-title { display: inline-flex; align-items: center; gap: var(--kom-space-2); white-space: nowrap; color: var(--kom-text-muted); font-size: var(--kom-text-xs); text-transform: uppercase; letter-spacing: .06em; }\n.command-tray__hint { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--kom-text-hint); font-size: var(--kom-text-xs); }\n.command-tray__commands .kom-btn { white-space: nowrap; }\n/* The primitive stacks a blocked button above its reason, which is right in a\n   panel and would be a second row here. Beside it instead — and both halves get\n   `min-width: 0`, because a flex item's automatic minimum is its min-content\n   width, which for `nowrap` text is the whole sentence. */\n.command-tray__commands .kom-btn-gate { flex-direction: row; align-items: center; gap: var(--kom-space-2); min-width: 0; }\n.command-tray__commands .kom-btn-reason { min-width: 0; max-width: 22ch; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n\n/* ── Activity rows ────────────────────────────────────────────────────────────\n * The four flat skeleton rows that used to live here are gone with the\n * placeholder they dressed. They were deliberately static — a shimmer would have\n * animated fake content and read as loading, when there was nothing to load —\n * and `activity.ts` now derives rows from what the client already knows, so what\n * this block dresses is a list.\n *\n * `flex: none` on both panels, and \"Cần chú ý\" first in the DOM: the column is\n * the scroller (`overflow-y: auto` further up), so a fifty-row feed placed above\n * it would put the panel that is waiting for an answer below fifty rows of\n * history that needs none.\n *\n * A row *is* one control rather than a row containing one, so `.kom-btn` is\n * re-shaped into the row's grid: a ghost pill drawn once per row reads as a\n * column of buttons instead of a list. Both selectors are (0,1,0) like `.kom-btn`\n * itself and this sheet is imported after the primitives, so the later\n * declaration is the one that lands. The ghost hover survives on purpose — it is\n * what tells the player the row goes somewhere. */\n.activity-panel { flex: none; }\n.activity-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }\n.activity-row + .activity-row { border-top: 1px solid var(--kom-border-subtle); }\n.activity-row__jump, .activity-row__static { display: grid; grid-template-columns: auto minmax(0, 1fr); justify-content: start; gap: var(--kom-space-1) var(--kom-space-3); align-items: start; width: 100%; padding: var(--kom-space-3) var(--kom-space-2); border-radius: 8px; text-align: left; }\n.activity-row__text { color: var(--kom-text-body); font-size: .82rem; font-weight: var(--kom-weight-regular); line-height: 1.45; }\n.activity-row__meta { grid-column: 2; display: flex; align-items: center; gap: var(--kom-space-3); color: var(--kom-text-hint); font-size: .74rem; font-weight: var(--kom-weight-regular); }\n.activity-empty { margin: 0; color: var(--kom-text-hint); font-size: .85rem; }\n\n/* The label is a word now, not a key: `text-transform: uppercase` was legible on\n   \"WOOD\" and is a diacritic pile-up on \"LƯƠNG THỰC\" at .7rem. Ellipsis instead of\n   wrap so a four-tile row keeps one height in every band. */\n.resource-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 7px; }.resource-grid div { background: var(--kom-surface-raised); border-radius: 8px; padding: 8px 5px; text-align: center; }.resource-grid span { display: block; color: var(--kom-text-muted); font-size: .7rem; text-align: center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.resource-grid strong { font-size: .95rem; }\n.resource-grid .resource-counter { display: flex; min-width: 0; flex-direction: column; align-items: center; justify-content: center; background: var(--kom-surface-raised); border-radius: 8px; padding: 8px 5px; text-align: center; }\nh1 { margin-top: 0; font-size: 1.6rem; } h2 { font-size: 1rem; margin-bottom: 6px; } p { color: var(--kom-text-body); font-size: .88rem; }\nbutton, input, select { border: 0; border-radius: 9px; padding: 11px 12px; font: inherit; } button { color: var(--kom-on-primary); background: var(--kom-primary); cursor: pointer; font-weight: 700; } button:disabled { cursor: not-allowed; opacity: .45; }\n.login-card { position: absolute; z-index: var(--kom-z-map-overlay); top: 50%; left: 50%; transform: translate(-50%, -50%); width: min(420px, calc(100vw - 32px)); display: grid; gap: 12px; padding: 26px; border-radius: 18px; background: var(--kom-bg-chrome); border: 1px solid var(--kom-border-strong); }\n.login-card input, .login-card select { color: var(--kom-text); background: var(--kom-surface-raised); }\n/* A field is its label above its control, so the name stays on screen after the\n   player types — a placeholder is gone exactly when it would be needed to check\n   what was filled in. `gap: 0` on the grid it sits in would separate a label from\n   the wrong control, so the field owns the pair. */\n.login-field { display: grid; gap: var(--kom-space-2); }\n.login-field > span { color: var(--kom-text-muted); font-size: var(--kom-text-sm); }\n/* One fixed layer, stacking. Every toast used to be `position: fixed` at the same\n   corner, so a second notice landed on top of the first and the first was simply\n   never read. `pointer-events` is the load-bearing part: the layer and the toast\n   let clicks through to the HUD underneath, and the dismiss button takes them\n   back — a notice about a command must not block the control that issues one. */\n.toast-layer { position: fixed; right: 18px; bottom: 86px; z-index: var(--kom-z-toast); display: flex; flex-direction: column; align-items: flex-end; gap: var(--kom-space-3); pointer-events: none; }\n.toast { display: flex; align-items: center; gap: var(--kom-space-4); max-width: min(92vw, 420px); padding: 12px 16px; border-radius: 10px; background: var(--kom-state-rejected-fill); color: var(--kom-state-rejected-text); box-shadow: var(--kom-shadow-raised); pointer-events: none; }\n.toast__text { min-width: 0; }\n.toast .toast__close { pointer-events: auto; flex: none; color: inherit; }\n.toast-info { background: var(--kom-info-fill); color: var(--kom-info-text); border: 1px solid var(--kom-info-border); }\n/* ── Drawer rows ──────────────────────────────────────────────────────────────\n * One row shape for all five drawer panels, in place of nine rules that each\n * dressed a single panel's own list. Three of those reached past a primitive with\n * a bare element selector — `.governance-actions button`, `.vote-card button` and\n * `.alliance-panel li button` are all (0,1,1) and took the padding straight back\n * off `.kom-btn--compact` at (0,1,0), which is why a compact button in the drawer\n * was a different size from a compact button everywhere else.\n *\n * No colour here at all. A world event's severity used to be a left rule in one\n * of two accents this file owned (`--kom-event-boon` / `--kom-event-blight`); it\n * is a `StatusChip` now, so the row is geometry and the state is the chip's. */\n.drawer-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }\n.drawer-row { display: flex; align-items: center; gap: var(--kom-space-3); flex-wrap: wrap; padding: var(--kom-space-3) 0; }\n/* Adjacent-sibling, not `:first-child`: the same class is also used standalone\n   (the leadership vote block), and a rule on the first row would put a hairline\n   above a block that has no list to be separated from. */\n.drawer-row + .drawer-row { border-top: 1px solid var(--kom-border-subtle); }\n/* The text takes the slack so controls stay right-aligned whoever the row is\n   about, and `min-width: 0` is what lets a long alliance name wrap instead of\n   pushing the buttons out of the 288px track. */\n.drawer-row__main { flex: 1 1 8rem; min-width: 0; display: flex; flex-direction: column; gap: var(--kom-space-1); }\n.drawer-form { display: flex; flex-direction: column; gap: var(--kom-space-3); }\n.drawer-form__row { display: flex; align-items: center; gap: var(--kom-space-3); flex-wrap: wrap; }\n.drawer-form__row input, .drawer-form__row select { flex: 1 1 8rem; min-width: 0; }\n.drawer-subhead { margin: 0; font-size: .85rem; color: var(--kom-text-heading); }\n.alliance-notice { margin: 0; padding: var(--kom-space-3); border-radius: 8px; background: var(--kom-surface-wash); color: var(--kom-text-body); font-size: .82rem; }\n.archive-content { display: flex; flex-direction: column; gap: var(--kom-space-3); }\n.archive-season > summary { cursor: pointer; color: var(--kom-text-heading); font-size: .82rem; }\n.archive-rank { padding: .15rem 0; color: var(--kom-text-body); font-size: .8rem; }\n.modal-backdrop { position: fixed; inset: 0; z-index: var(--kom-z-modal); display: flex; align-items: center; justify-content: center; background: var(--kom-scrim); }\n/* Two buttons now, so a row rather than a corner: they are the only chrome that\n   floats over the canvas, and stacking is what a third one would need. Sizing is\n   `density=\"compact\"` on the primitive, not a rule for a raw <button>. */\n.map-toolbar { position: absolute; top: 12px; right: 12px; z-index: var(--kom-z-map-overlay); display: flex; gap: var(--kom-space-2); }\n.strategic-minimap { position: absolute; left: var(--kom-space-4); bottom: var(--kom-space-4); z-index: var(--kom-z-map-overlay); width: 168px; padding: var(--kom-space-2); border: 1px solid var(--kom-border-strong); background: var(--kom-minimap-bg); box-shadow: var(--kom-shadow-raised); }\n.strategic-minimap__head { display: flex; justify-content: space-between; gap: var(--kom-space-2); margin-bottom: var(--kom-space-2); color: var(--kom-text-heading); font-size: var(--kom-text-xs); }\n.strategic-minimap__head span { color: var(--kom-text-muted); }\n.strategic-minimap svg { display: block; width: 144px; height: 144px; margin: auto; border: 1px solid var(--kom-minimap-border); cursor: crosshair; }\n.modal-card { width: min(440px, calc(100vw - 32px)); max-height: 80vh; overflow-y: auto; padding: 20px; border: 1px solid var(--kom-border-strong); border-radius: 16px; background: var(--kom-bg-chrome); box-shadow: var(--kom-shadow-modal); }\n/* CityView 3D full-screen view */\n.city-view {\n  position: fixed;\n  inset: 0;\n  z-index: 1000;\n  display: flex;\n  flex-direction: column;\n  background: var(--kom-ink-900);\n  color: var(--kom-text-body);\n  overflow: hidden;\n  animation: city-view-fade-in 450ms cubic-bezier(0.16, 1, 0.3, 1) forwards;\n}\n\n@keyframes city-view-fade-in {\n  from { opacity: 0; transform: scale(0.985); }\n  to { opacity: 1; transform: scale(1); }\n}\n\n.city-view-canvas {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n}\n\n.city-view-canvas canvas { display: block; width: 100%; height: 100%; cursor: grab; }\n.city-view--edit .city-view-canvas canvas,\n.city-view--place .city-view-canvas canvas { cursor: crosshair; }\n\n.city-view-bootstrap {\n  position: fixed;\n  inset: 0;\n  z-index: 1000;\n  display: grid;\n  place-items: center;\n  background: var(--kom-ink-900);\n  color: var(--kom-text-heading);\n}\n\n.city-view-fallback-shell { position: absolute; inset: 0; }\n.city-view-fallback-message {\n  position: absolute;\n  top: 86px;\n  left: 50%;\n  transform: translateX(-50%);\n  z-index: 5;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 8px 12px;\n  border: 1px solid var(--kom-state-uncertain-border);\n  border-radius: 10px;\n  background: var(--kom-bg-chrome);\n  box-shadow: var(--kom-shadow-modal);\n  font-size: var(--kom-text-xs);\n}\n\n.city-view-loading {\n  position: absolute;\n  inset: 0;\n  z-index: 50;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: var(--kom-ink-900-veil);\n  backdrop-filter: blur(8px);\n}\n\n.city-view-loading-box {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: var(--kom-space-3);\n  padding: var(--kom-space-6);\n  border: 1px solid var(--kom-border-strong);\n  border-radius: var(--kom-radius-lg);\n  background: var(--kom-bg-chrome);\n  box-shadow: var(--kom-shadow-modal);\n  min-width: 280px;\n}\n\n.city-view-loading-kicker,\n.city-view-placement-toolbar small,\n.city-view-title small {\n  color: var(--kom-text-accent);\n  font-size: var(--kom-text-2xs);\n  font-weight: var(--kom-weight-bold);\n  letter-spacing: .12em;\n}\n\n.city-view-loading-box h3 { margin: 0; color: var(--kom-text-heading); }\n\n.city-view-progress-bar {\n  width: 100%;\n  height: 8px;\n  border-radius: var(--kom-radius-pill);\n  background: var(--kom-surface-raised);\n  overflow: hidden;\n}\n\n.city-view-progress-fill {\n  height: 100%;\n  background: var(--kom-primary);\n  transition: width 150ms ease-out;\n}\n\n.city-view-topbar {\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  z-index: 20;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 12px 20px;\n  background: linear-gradient(to bottom, var(--kom-ink-900-veil) 0%, transparent 100%);\n  pointer-events: auto;\n  gap: var(--kom-space-4);\n}\n\n.city-view-topbar-left {\n  display: flex;\n  align-items: center;\n  gap: var(--kom-space-3);\n}\n\n.city-view-title h2 {\n  margin: 0;\n  font-size: var(--kom-text-base);\n  font-weight: var(--kom-weight-bold);\n  color: var(--kom-text-heading);\n  line-height: var(--kom-leading-tight);\n}\n\n.city-view-title { display: flex; flex-direction: column; }\n\n.city-view-badge {\n  font-size: var(--kom-text-xs);\n  color: var(--kom-text-muted);\n}\n\n.city-view-topbar-center {\n  display: flex;\n  align-items: center;\n}\n\n.city-view-resources {\n  display: flex;\n  align-items: center;\n  gap: var(--kom-space-4);\n  padding: 4px 14px;\n  border-radius: var(--kom-radius-pill);\n  background: var(--kom-bg-chrome);\n  border: 1px solid var(--kom-border-subtle);\n  font-size: var(--kom-text-sm);\n}\n.city-view-resource { display: inline-flex; align-items: center; gap: 5px; }\n.resource-counter--food, .city-view-resource--food { color: var(--kom-allied-soft); }\n.resource-counter--wood, .city-view-resource--wood { color: var(--kom-primary-soft); }\n.resource-counter--stone, .city-view-resource--stone { color: var(--kom-neutral-soft); }\n.resource-counter--iron, .city-view-resource--iron { color: var(--kom-hostile-soft); }\n\n.city-view-topbar-right {\n  display: flex;\n  align-items: center;\n  gap: var(--kom-space-3);\n}\n\n.city-view-queue-status {\n  font-size: var(--kom-text-xs);\n  color: var(--kom-text-muted);\n  padding: 4px 10px;\n  border-radius: var(--kom-radius-pill);\n  background: var(--kom-surface-sunken);\n}\n\n.city-view-quality {\n  color: var(--kom-text-accent);\n  font-size: var(--kom-text-2xs);\n  letter-spacing: .08em;\n}\n\n.city-view-placement-toolbar {\n  position: absolute;\n  top: 76px;\n  left: 50%;\n  transform: translateX(-50%);\n  z-index: 26;\n  display: flex;\n  align-items: center;\n  gap: 24px;\n  min-width: min(620px, calc(100vw - 32px));\n  padding: 10px 14px;\n  border: 1px solid var(--kom-border-accent);\n  border-radius: 14px;\n  background: var(--kom-ink-850);\n  box-shadow: var(--kom-shadow-modal);\n  backdrop-filter: blur(14px);\n}\n\n.city-view-placement-toolbar > div:first-child {\n  flex: 1;\n  display: grid;\n  gap: 2px;\n}\n\n.city-view-placement-toolbar strong { color: var(--kom-text-heading); }\n.city-view-placement-help { color: var(--kom-text-muted); font-size: var(--kom-text-xs); }\n.city-view-placement-toolbar .is-valid { color: var(--kom-state-friendly-text); font-size: var(--kom-text-xs); }\n.city-view-placement-toolbar .is-invalid { color: var(--kom-state-hostile-text); font-size: var(--kom-text-xs); }\n.city-view-placement-actions { display: flex; gap: 8px; }\n\n.city-view-edit-toolbar {\n  position: absolute;\n  top: 68px;\n  left: 50%;\n  transform: translateX(-50%);\n  z-index: 25;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 16px;\n  border: 1px solid var(--kom-border-accent);\n  border-radius: 12px;\n  background: var(--kom-ink-850);\n  backdrop-filter: blur(12px);\n  box-shadow: var(--kom-shadow-modal);\n}\n\n.city-view-edit-hint {\n  font-size: var(--kom-text-xs);\n  color: var(--kom-text-accent);\n}\n\n.city-view-edit-actions {\n  display: flex;\n  align-items: center;\n  gap: var(--kom-space-2);\n}\n\n.city-view-bottom-dock {\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  z-index: 20;\n  display: flex;\n  justify-content: center;\n  padding: 16px 20px;\n  background: linear-gradient(to top, var(--kom-ink-900-veil) 0%, transparent 100%);\n  pointer-events: auto;\n}\n\n.city-view-building-chips {\n  display: flex;\n  align-items: center;\n  gap: var(--kom-space-3);\n}\n\n.city-view-chip {\n  display: flex;\n  align-items: center;\n  gap: var(--kom-space-2);\n  padding: 6px 14px 6px 8px;\n  border: 1px solid var(--kom-border-strong);\n  border-radius: 12px;\n  background: var(--kom-bg-chrome);\n  color: var(--kom-text-body);\n  cursor: pointer;\n  transition: all 120ms ease;\n  backdrop-filter: blur(6px);\n}\n\n.city-view-chip img {\n  width: 36px;\n  height: 36px;\n  object-fit: contain;\n}\n\n.city-view-chip-info {\n  display: flex;\n  flex-direction: column;\n  text-align: left;\n}\n\n.city-view-chip-info strong {\n  font-size: var(--kom-text-xs);\n  color: var(--kom-text-heading);\n}\n\n.city-view-chip-info small {\n  font-size: var(--kom-text-2xs);\n  color: var(--kom-text-muted);\n}\n\n.city-view-chip:hover {\n  border-color: var(--kom-primary);\n  background: var(--kom-surface-raised);\n  transform: translateY(-2px);\n}\n\n.city-view-chip.is-selected {\n  border-color: var(--kom-primary);\n  box-shadow: 0 0 12px var(--kom-primary-tint);\n  background: var(--kom-surface-hover);\n}\n\n.city-view-chip.is-building {\n  border-color: var(--kom-state-uncertain-border);\n}\n\n.city-view-inspector {\n  position: absolute;\n  right: 24px;\n  bottom: 96px;\n  width: 320px;\n  max-width: calc(100vw - 48px);\n  z-index: 30;\n  padding: 16px;\n  border: 1px solid var(--kom-border-strong);\n  border-radius: 14px;\n  background: var(--kom-bg-chrome);\n  backdrop-filter: blur(16px);\n  box-shadow: var(--kom-shadow-modal);\n  display: flex;\n  flex-direction: column;\n  gap: var(--kom-space-3);\n  animation: inspector-slide-up 200ms ease-out forwards;\n}\n\n@keyframes inspector-slide-up {\n  from { opacity: 0; transform: translateY(12px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n.city-view-inspector-header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n}\n\n.city-view-inspector-title {\n  display: flex;\n  align-items: center;\n  gap: var(--kom-space-3);\n}\n\n.city-view-inspector-title img {\n  width: 44px;\n  height: 44px;\n  object-fit: contain;\n}\n\n.city-view-inspector-title h3 {\n  margin: 0;\n  font-size: var(--kom-text-sm);\n  color: var(--kom-text-heading);\n}\n\n.city-view-inspector-title span {\n  font-size: var(--kom-text-xs);\n  color: var(--kom-text-muted);\n}\n\n.city-view-inspector-close {\n  background: transparent;\n  border: 0;\n  color: var(--kom-text-muted);\n  font-size: 1.2rem;\n  cursor: pointer;\n  padding: 0 4px;\n  line-height: 1;\n}\n\n.city-view-inspector-desc {\n  margin: 0;\n  font-size: var(--kom-text-xs);\n  color: var(--kom-text-body);\n  line-height: var(--kom-leading-normal);\n}\n\n.city-view-inspector-note {\n  margin: 0;\n  font-size: var(--kom-text-xs);\n  color: var(--kom-text-accent);\n  padding: 6px 10px;\n  border-radius: 6px;\n  background: var(--kom-primary-tint);\n}\n\n.city-view-inspector-coords {\n  display: flex;\n  gap: var(--kom-space-3);\n  font-size: var(--kom-text-2xs);\n  color: var(--kom-text-muted);\n}\n\n.city-view-inspector-footer {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-top: var(--kom-space-1);\n  padding-top: var(--kom-space-2);\n  border-top: 1px solid var(--kom-border-subtle);\n}\n\n.city-view-inspector-cost {\n  display: flex;\n  flex-direction: column;\n}\n\n.city-view-inspector-cost small {\n  font-size: var(--kom-text-2xs);\n  color: var(--kom-text-muted);\n}\n\n.city-view-inspector-cost span {\n  font-size: var(--kom-text-xs);\n  font-weight: var(--kom-weight-bold);\n  color: var(--kom-text-heading);\n}\n\n.report-meta { color: var(--kom-text-muted); }.report-sides { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 12px 0; }.report-side { padding: 10px; border-radius: 10px; background: var(--kom-surface-raised); }.report-side p { margin: 4px 0; font-size: .8rem; }.report-rounds { margin-top: 8px; color: var(--kom-text-body); }.report-rounds summary { cursor: pointer; }\n/* The one surface that quotes a price in reputation: the frozen banner's edge and\n   ink over the hostile chip's lighter wash, so it reads as a cost, not a state. */\n.reputation-cost { color: var(--kom-state-frozen-text); background: var(--kom-state-hostile-fill); border: 1px solid var(--kom-state-frozen-border); border-radius: 8px; padding: 8px 10px; }\n\n/* Panels (city & logistics & army)\n *\n * Nothing in this file dresses a panel any more. `.hud section` gave every\n * surface in the column its background, radius and 1rem of padding, and\n * `.hud .kom-panel` existed only to take that padding back off the primitive it\n * out-specified. Both are gone: all thirteen surfaces are `Panel`s now, so the\n * primitive owns the box and the column owns the gap. What follows is layout\n * *inside* a panel body — rows, grids and steppers, no surface. */\n.hint { color: var(--kom-text-hint); font-size: .85em; line-height: 1.45; margin: .3rem 0; }\n.logistics-panel h3 { font-size: .9rem; margin: 0; color: var(--kom-text-heading); }\n/* Not a `Panel` each: three nested surfaces inside one panel body draw three\n   backgrounds and three shadows for what is one list of controls. A flat block\n   with its own column gap is the same rhythm without the extra boxes. */\n.logistics-block { display: flex; flex-direction: column; gap: var(--kom-space-3); }\n.building-row, .node-row, .route-row, .caravan-row { padding: .5rem .4rem; border-top: 1px solid var(--kom-border-subtle); display: flex; flex-direction: column; gap: .3rem; }\n.building-row:first-of-type { border-top: none; }\n.building-title { display: flex; justify-content: space-between; align-items: baseline; gap: .5rem; }\n/* The three build shortcuts are laid out for a 360px panel. In a 288px track,\n   three `flex: 1` buttons are 72px wide and \"Xây trạm trung chuyển\" breaks into\n   four lines, so the row wraps two-up instead. */\n.city-actions { display: flex; flex-wrap: wrap; gap: var(--kom-space-3); }\n.city-action { flex: 1 1 46%; display: flex; flex-direction: column; gap: var(--kom-space-2); }\n/* `Button.reason` wraps a gated button in `.kom-btn-gate`, so the width has to be\n   handed down through the wrapper as well: setting it on `.kom-btn` alone would\n   make a shortcut change width the moment it became unaffordable. */\n.city-action .kom-btn-gate, .city-action .kom-btn { width: 100%; }\n/* One control and the status of the order it issued, on one line. */\n.row-actions, .control-status { display: flex; align-items: center; gap: var(--kom-space-2); flex-wrap: wrap; }\n.node-row, .route-row { flex-direction: row; justify-content: space-between; align-items: center; gap: .5rem; flex-wrap: wrap; }\n.route-creator, .escort-row { display: flex; gap: .4rem; flex-wrap: wrap; align-items: center; }\n.route-creator select, .escort-row select { flex: 1; min-width: 110px; }\n.cargo-grid { display: flex; gap: .6rem; flex-wrap: wrap; margin: 0; }\n.cargo-stepper { display: inline-flex; gap: .35rem; align-items: center; }\n.cargo-grid strong { min-width: 1.6rem; text-align: center; }\n.export-note { border: 1px dashed var(--kom-border-accent); }\n\n/* Army panel */\n.army-row { padding: .5rem .4rem; border-top: 1px solid var(--kom-border-subtle); display: flex; flex-direction: column; gap: .35rem; }\n.army-row:first-of-type { border-top: none; }\n/* The army the player picked on the map. An attribute rather than a class because\n   it is the same \"you are here\" the column's nav marks, and marking it twice in\n   two vocabularies is how the two get out of step. */\n.army-row[aria-current=\"true\"] { border-left: 2px solid var(--kom-primary); padding-left: calc(.4rem - 2px); background: var(--kom-surface-hover); }\n.army-title, .army-stats { display: flex; justify-content: space-between; align-items: center; gap: .5rem; flex-wrap: wrap; }\n/* Not `space-between` like the two rows above it: a pending chip appears beside\n   the control that issued the order and disappears when it settles, and a spread\n   row would shove every other control sideways each time it did. */\n.army-actions { display: flex; align-items: center; gap: var(--kom-space-2); flex-wrap: wrap; }\n.army-actions select { font-size: .8rem; }\n.low-supply { color: var(--kom-supply-low); font-weight: 700; }\n/* One choice in a dialog: a radio, its label, and nothing else. It was\n   `.recruit-choice` while the recruit modal was the only dialog that asked a\n   question; the tray's merge dialog asks the same shape of question, and a second\n   copy of four properties under a second name is how two dialogs start looking\n   different for no reason. */\n.modal-choice { display: flex; gap: .5rem; align-items: flex-start; margin: .4rem 0; }\n.modal-actions { display: flex; gap: .5rem; justify-content: flex-end; margin-top: .8rem; }\n\n/* Onboarding & advanced drawer */\n/* Onboarding & advanced drawer\n *\n * The `margin-top` came off with the bridge: the column's `gap` spaces the drawer\n * from the panel above it, and leaving both would have doubled to 32px. The\n * `> summary` is direct-descendant on purpose — `.drawer summary` also caught the\n * per-season `<summary>` inside the archive panel, so the two disclosures could\n * not be sized independently. */\n.drawer { padding: .8rem 1rem; background: var(--kom-surface); border-radius: 12px; }\n.drawer > summary { cursor: pointer; font-weight: 600; color: var(--kom-text-heading); }\n.drawer > summary::marker { color: var(--kom-text-link); }\n/* The five drawer panels were spaced by `.hud section`'s margin, which is gone;\n   this is the same job the column does one level up, at the tighter step because\n   these are panels nested inside a panel-shaped disclosure. */\n.advanced-drawer { display: flex; flex-direction: column; gap: var(--kom-space-5); margin-top: var(--kom-space-5); }\n.onboarding-list { list-style: none; margin: .5rem 0 0; padding: 0; display: flex; flex-direction: column; gap: .35rem; }\n.onboarding-list li { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }\n.step-dot, .step-check { width: 1.15rem; height: 1.15rem; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: .72rem; background: var(--kom-surface-chip); flex: none; }\n.step-check { background: var(--kom-allied-deep); color: var(--kom-allied-soft); }\n.step-done .step-label { color: var(--kom-allied-muted); text-decoration: line-through; }\n.step-actions { display: inline-flex; gap: .35rem; margin-left: auto; }\n/* Quest rows carry two lines of text where onboarding steps carry one — the\n   label stacks, and only the done strike-through inherits from `.step-done`\n   above, so a finished quest reads at a glance like a finished step. */\n.daily-quest-list .step-label { display: flex; flex-direction: column; gap: .1rem; min-width: 0; }\n.daily-quest-list .step-label small { color: var(--kom-text-muted); }\n/* Milestones sit under the quest list as claim rows, not steps — a meta line\n   plus its button, the same two-column shape `.spy-mission` uses. */\n.daily-milestones { display: flex; flex-direction: column; gap: .3rem; margin-top: .5rem; }\n.daily-milestone { display: flex; align-items: center; justify-content: space-between; gap: .5rem; flex-wrap: wrap; padding-top: .3rem; border-top: 1px solid var(--kom-border-subtle); }\n.spy-launch { display: flex; gap: .4rem; flex-wrap: wrap; margin-bottom: .5rem; }\n/* Inside a panel footer the row *is* the action band, so the footer owns the\n   spacing and the row takes the full width its selects were sized against. */\n.kom-panel__footer .spy-launch { flex: 1; margin-bottom: 0; }\n.spy-launch select { flex: 1; min-width: 100px; }\n.spy-mission { display: flex; gap: .5rem; align-items: baseline; flex-wrap: wrap; padding: .3rem 0; border-top: 1px solid var(--kom-border-subtle); }\n.spy-mission:first-of-type { border-top: none; }\n\n/* Pending command strip\n *\n * A compact `Panel` now, so the header and the rhythm come from the primitive and\n * only the surface is stated here: the strip is deliberately *sunken* where every\n * other panel is raised, because it holds orders in flight rather than a place to\n * give one. `.pending-strip` is (0,1,0) like `.kom-panel`, and this file is\n * imported after the primitives, so the later rule wins without a specificity\n * bump. The old `.pending-strip h3` had to go with the `<h3>`: at (0,1,1) it\n * out-specified `.kom-panel__heading` and would have resized one panel's title. */\n.pending-strip { background: var(--kom-surface-sunken); }\n.pending-row { display: flex; justify-content: space-between; align-items: center; gap: .5rem; font-size: .8rem; padding: .3rem 0; }\n\n/* ── BANDS ────────────────────────────────────────────────────────────────────\n * The same two numbers as `layoutBreakpoints` in `layout.ts`, which\n * `layout.test.ts` checks against this file as text so the pair cannot drift.\n *\n * Each band *promotes* a flyout into a grid track. Written that way — base rules\n * are the flyout, media rules are the track — the cascade needs no specificity\n * bump anywhere, only source order, and the compact case is the one that needs no\n * query at all. */\n@media (min-width: 1024px) {\n  .situation-room { --kom-col-kingdom: 288px; }\n  .kingdom-column { grid-area: kingdom; width: 100%; box-shadow: none; }\n}\n\n@media (max-width: 700px) {\n  .city-view-topbar { padding: 8px 12px; }\n  .city-view-resources { display: none; }\n  .city-view-quality { display: none; }\n  .city-view-title h2 { max-width: 130px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n  .city-view-topbar-right { gap: 4px; }\n  .city-view-queue-status { display: none; }\n  .city-view-edit-toolbar { top: 60px; width: calc(100vw - 24px); }\n  .city-view-edit-hint { display: none; }\n  .city-view-edit-actions { flex-wrap: wrap; justify-content: center; }\n  .city-view-placement-toolbar { top: 72px; flex-direction: column; align-items: stretch; gap: 8px; min-width: 0; width: calc(100vw - 24px); }\n  .city-view-placement-actions { justify-content: stretch; }\n  .city-view-placement-actions > * { flex: 1; }\n  .city-view-bottom-dock { justify-content: flex-start; overflow-x: auto; padding: 12px; scrollbar-width: none; }\n  .city-view-building-chips { gap: var(--kom-space-1); min-width: max-content; }\n  .city-view-chip { padding: 4px 8px; min-width: 116px; }\n  .city-view-chip img { width: 28px; height: 28px; }\n  .city-view-inspector { left: 16px; right: 16px; bottom: 84px; width: auto; }\n  .city-view-fallback-message { top: 116px; width: calc(100vw - 32px); flex-wrap: wrap; }\n}\n\n@media (min-width: 1440px) {\n  .situation-room { --kom-col-activity: 320px; }\n  .activity-column { grid-area: activity; width: 100%; box-shadow: none; }\n  .strategic-header { min-height: 60px; gap: var(--kom-space-4) var(--kom-space-6); padding: var(--kom-space-3) var(--kom-space-6); }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .conn-reconnecting .connection-dot, .conn-connecting .connection-dot { animation: none; }\n  .city-view { animation: none; }\n  .city-view-inspector { animation: none; }\n}\n\n/* ── FULL-SCREEN GAME HUD ───────────────────────────────────────────────────\n * The strategic map is the scene, not one cell of an application dashboard.\n * Everything else is a floating HUD surface over it: identity and resources at\n * the top, contextual orders above the bottom edge, and two opt-in drawers. */\n.situation-room {\n  position: relative;\n  display: block;\n  isolation: isolate;\n  height: 100%;\n  overflow: hidden;\n}\n\n.situation-room .map {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  z-index: 0;\n}\n\n.strategic-header {\n  position: absolute;\n  inset: 0;\n  z-index: 30;\n  display: block;\n  min-height: 0;\n  padding: 0;\n  border: 0;\n  background: none;\n  pointer-events: none;\n}\n\n.strategic-header > * { pointer-events: auto; }\n\n.strategic-header .brand {\n  position: absolute;\n  top: var(--kom-space-4);\n  left: var(--kom-space-4);\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n  gap: var(--kom-space-3);\n  max-width: 260px;\n  padding: var(--kom-space-2) var(--kom-space-4) var(--kom-space-2) var(--kom-space-2);\n  border: 1px solid var(--kom-border-strong);\n  border-radius: 999px;\n  background: var(--kom-bg-chrome);\n  box-shadow: var(--kom-shadow-raised);\n}\n\n.brand__crest {\n  display: grid;\n  flex: none;\n  place-items: center;\n  width: 42px;\n  height: 42px;\n  border: 2px solid var(--kom-primary);\n  border-radius: 50%;\n  background: var(--kom-primary-tint);\n  color: var(--kom-primary);\n  font-family: var(--kom-font-display);\n  font-size: var(--kom-text-lg);\n  font-weight: var(--kom-weight-bold);\n}\n.brand__crest--frame_meridian,\n.hub-profile-crest--frame_meridian { box-shadow: 0 0 0 3px var(--kom-cosmetic-frame-meridian), 0 0 0 5px var(--kom-cosmetic-frame-ring); }\n.brand__crest--frame_sentinel,\n.hub-profile-crest--frame_sentinel { box-shadow: 0 0 0 3px var(--kom-cosmetic-frame-sentinel), 0 0 0 5px var(--kom-cosmetic-sentinel-ring); }\n.brand__nameplate--nameplate_brass { color: var(--kom-cosmetic-brass) !important; }\n.brand__nameplate--nameplate_slate { color: var(--kom-cosmetic-slate) !important; }\n\n.brand__copy { min-width: 0; }\n.strategic-header .brand h1 { font-size: var(--kom-text-sm); }\n.brand__line { display: block; color: var(--kom-text-muted); font-size: var(--kom-text-xs); }\n\n.strategic-header .resource-grid {\n  position: absolute;\n  top: var(--kom-space-4);\n  left: 50%;\n  display: grid;\n  grid-template-columns: repeat(4, minmax(68px, 1fr));\n  gap: var(--kom-space-1);\n  width: min(390px, 38vw);\n  margin: 0;\n  padding: var(--kom-space-1);\n  border: 1px solid var(--kom-border-strong);\n  border-radius: 999px;\n  background: var(--kom-bg-chrome);\n  box-shadow: var(--kom-shadow-raised);\n  transform: translateX(-50%);\n}\n\n.strategic-header .resource-grid .resource-counter {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--kom-space-2);\n  min-width: 0;\n  padding: var(--kom-space-2) var(--kom-space-3);\n  border-radius: 999px;\n  background: var(--kom-surface-raised);\n}\n\n.strategic-header .resource-grid span { font-size: var(--kom-text-2xs); }\n.strategic-header .resource-grid strong { font-size: var(--kom-text-sm); }\n\n.strategic-header .season {\n  position: absolute;\n  top: var(--kom-space-4);\n  right: 126px;\n  min-height: 44px;\n  padding: var(--kom-space-2) var(--kom-space-4);\n  border: 1px solid var(--kom-border-strong);\n  border-radius: 999px;\n  background: var(--kom-bg-chrome);\n  box-shadow: var(--kom-shadow-raised);\n}\n\n.strategic-header .connection-pill {\n  position: absolute;\n  top: var(--kom-space-5);\n  right: var(--kom-space-4);\n  box-shadow: var(--kom-shadow-raised);\n}\n\n.header-surfaces {\n  position: absolute;\n  bottom: var(--kom-space-4);\n  right: var(--kom-space-4);\n  display: flex;\n  gap: var(--kom-space-2);\n  padding: var(--kom-space-2);\n  border: 1px solid var(--kom-border-strong);\n  border-radius: 18px;\n  background: var(--kom-bg-chrome);\n  box-shadow: var(--kom-shadow-modal);\n  transform: none;\n}\n\n.header-surfaces .kom-btn {\n  min-width: 112px;\n  flex-direction: column;\n  gap: 2px;\n  border-radius: 12px;\n  color: var(--kom-text-muted);\n}\n\n.header-surfaces .kom-btn span { font-size: var(--kom-text-2xs); }\n.header-surfaces .header-toggle--on {\n  color: var(--kom-primary);\n  background: var(--kom-primary-tint);\n  box-shadow: inset 0 -2px 0 currentColor;\n}\n.header-surfaces .header-logout { min-width: 72px; color: var(--kom-text-hint); }\n\n.frozen-banner { top: 76px; }\n\n.kingdom-column,\n.activity-column {\n  position: absolute;\n  top: 80px;\n  bottom: 92px;\n  z-index: 40;\n  width: min(380px, calc(100vw - 32px));\n  border: 1px solid var(--kom-border-strong);\n  border-radius: 18px;\n  background: var(--kom-bg-context);\n  box-shadow: var(--kom-shadow-modal);\n  overscroll-behavior: contain;\n}\n\n.kingdom-column {\n  left: var(--kom-space-4);\n  padding: 0 var(--kom-space-5) var(--kom-space-5);\n  border-right: 1px solid var(--kom-border-strong);\n}\n\n.activity-column {\n  right: var(--kom-space-4);\n  padding: 0 var(--kom-space-5) var(--kom-space-5);\n  border-left: 1px solid var(--kom-border-strong);\n}\n\n.kingdom-column__head,\n.activity-column__head {\n  position: sticky;\n  top: 0;\n  z-index: 2;\n  margin: 0 calc(var(--kom-space-5) * -1);\n  padding: var(--kom-space-4) var(--kom-space-5);\n  border-bottom: 1px solid var(--kom-border-strong);\n  background: var(--kom-bg-rail);\n}\n\n.drawer-title-row { display: flex; align-items: center; justify-content: space-between; gap: var(--kom-space-4); }\n.drawer-title-row h2 { margin: 0; color: var(--kom-text-heading); }\n.drawer-kicker { color: var(--kom-primary); font-size: var(--kom-text-2xs); font-weight: var(--kom-weight-bold); letter-spacing: .1em; }\n.drawer-close { flex: none; min-width: 36px; padding: var(--kom-space-2); font-size: var(--kom-text-lg); }\n\n.map-toolbar {\n  top: 84px;\n  right: var(--kom-space-4);\n  z-index: 20;\n  flex-direction: column;\n  align-items: flex-end;\n}\n\n.map-toolbar .kom-btn {\n  border: 1px solid var(--kom-border-strong);\n  border-radius: 999px;\n  background: var(--kom-bg-chrome);\n  box-shadow: var(--kom-shadow-raised);\n}\n.map-asset-error { position: absolute; top: 50%; left: 50%; z-index: 25; display: grid; gap: var(--kom-space-3); width: min(320px, calc(100vw - 40px)); padding: var(--kom-space-6); transform: translate(-50%, -50%); border: 1px solid var(--kom-state-hostile-border); background: var(--kom-bg-context); box-shadow: var(--kom-shadow-modal); color: var(--kom-state-hostile-text); text-align: center; }\n.map-asset-error span { color: var(--kom-text-body); font-size: var(--kom-text-sm); }\n\n.command-tray {\n  position: absolute;\n  z-index: 35;\n  min-height: 0;\n  border: 1px solid var(--kom-border-strong);\n  border-radius: 16px;\n  background: var(--kom-bg-chrome);\n  box-shadow: var(--kom-shadow-modal);\n}\n\n.command-tray--active {\n  right: var(--kom-space-4);\n  bottom: 92px;\n  left: var(--kom-space-4);\n}\n\n.command-tray--idle {\n  bottom: var(--kom-space-4);\n  left: var(--kom-space-4);\n  width: auto;\n  max-width: min(420px, calc(100vw - 32px));\n}\n\n.command-tray--idle .command-tray__commands { display: none; }\n.command-tray__context { padding: var(--kom-space-3) var(--kom-space-4); }\n.command-tray__commands { padding: var(--kom-space-2) var(--kom-space-4); }\n.toast-layer { bottom: 98px; }\n\n@media (max-width: 1180px) {\n  .strategic-header .season { display: none; }\n  .strategic-header .resource-grid { left: auto; right: var(--kom-space-4); transform: none; }\n  .strategic-header .connection-pill { top: 72px; }\n  .map-toolbar { top: 110px; }\n  .command-tray--idle { bottom: 92px; }\n}\n\n@media (max-width: 1023px) {\n  .header-surfaces [data-header-tool=\"profile\"],\n  .header-surfaces [data-header-tool=\"shop\"],\n  .header-surfaces [data-header-tool=\"alliance\"],\n  .header-surfaces [data-header-tool=\"reports\"] { display: none; }\n}\n\n@media (max-width: 700px) {\n  .strategic-header .brand {\n    top: var(--kom-space-2);\n    left: var(--kom-space-2);\n    padding: var(--kom-space-1);\n  }\n  .brand__crest { width: 38px; height: 38px; }\n  .brand__copy { display: none; }\n  .strategic-header .resource-grid {\n    top: var(--kom-space-2);\n    right: var(--kom-space-2);\n    width: calc(100vw - 60px);\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n  }\n  .strategic-header .resource-grid .resource-counter { padding: var(--kom-space-2) var(--kom-space-1); }\n  .strategic-header .resource-grid span { display: none; }\n  .strategic-header .connection-pill { display: none; }\n  .header-surfaces { right: var(--kom-space-2); bottom: var(--kom-space-2); left: var(--kom-space-2); width: auto; justify-content: center; transform: none; }\n  .header-surfaces .kom-btn { min-width: 0; flex: 1; padding: var(--kom-space-2); }\n  .header-surfaces .header-logout { min-width: 0; }\n  .kingdom-column,\n  .activity-column {\n    top: 60px;\n    right: var(--kom-space-2);\n    bottom: 70px;\n    left: var(--kom-space-2);\n    width: auto;\n  }\n  .map-toolbar { top: 62px; right: var(--kom-space-2); }\n  .strategic-minimap { left: var(--kom-space-2); bottom: 76px; transform: scale(.82); transform-origin: bottom left; }\n  .map-toolbar .kom-btn { min-width: 40px; width: 40px; height: 40px; padding: var(--kom-space-2); font-size: 0; }\n  .map-toolbar .kom-icon { width: var(--kom-icon-md); height: var(--kom-icon-md); }\n  .command-tray--active {\n    right: var(--kom-space-2);\n    bottom: 72px;\n    left: var(--kom-space-2);\n    flex-direction: column;\n    align-items: stretch;\n  }\n  .command-tray--active .command-tray__commands { border-top: 1px solid var(--kom-border-accent); border-left: 0; overflow-x: auto; }\n  .command-tray--idle { display: none; }\n  .toast-layer { bottom: 76px; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .kingdom-column,\n  .activity-column { scroll-behavior: auto; }\n}\n\n/* Player hub: compact cards keep the map visible behind one focused modal. */\n.player-hub-modal { width: min(720px, calc(100vw - 32px)); max-height: min(760px, calc(100vh - 32px)); overflow: auto; }\n.hub-tabs { display: flex; gap: var(--kom-space-2); margin-bottom: var(--kom-space-5); border-bottom: 1px solid var(--kom-border-subtle); }\n.hub-tabs .kom-btn { border-radius: var(--kom-radius-sm) var(--kom-radius-sm) 0 0; }\n.hub-wallet { display: flex; align-items: center; gap: var(--kom-space-3); margin-bottom: var(--kom-space-5); padding: var(--kom-space-4); border: 1px solid var(--kom-border-accent); background: var(--kom-primary-tint); color: var(--kom-text-accent); }\n.hub-wallet strong { color: var(--kom-primary); font-size: var(--kom-text-xl); }\n.hub-profile { display: grid; grid-template-columns: auto 1fr; gap: var(--kom-space-4); align-items: center; }\n.hub-profile-crest { display: grid; place-items: center; width: 64px; height: 64px; border: 3px solid var(--kom-primary); border-radius: 50%; color: var(--kom-primary); font-size: var(--kom-text-2xl); font-weight: var(--kom-weight-bold); }\n.hub-profile h3, .hub-item h3, .hub-slot h3, .hub-rewards h3 { margin: 0; color: var(--kom-text-heading); }\n.hub-profile p, .hub-item p, .hub-slot p { margin: var(--kom-space-2) 0 0; color: var(--kom-text-muted); }\n.hub-score-grid { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--kom-space-2); }\n.hub-score-grid span { display: grid; gap: 2px; padding: var(--kom-space-3); background: var(--kom-surface-sunken); }\n.hub-score-grid small { color: var(--kom-text-hint); text-transform: uppercase; font-size: var(--kom-text-2xs); }\n.hub-catalog, .hub-inventory { display: grid; gap: var(--kom-space-3); }\n.hub-item { display: grid; grid-template-columns: 56px 1fr auto; gap: var(--kom-space-4); align-items: center; padding: var(--kom-space-3); border: 1px solid var(--kom-bo