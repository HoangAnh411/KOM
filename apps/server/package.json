{
  "name": "@kingdoms/server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {"build": "tsc -p tsconfig.json", "typecheck": "tsc -p tsconfig.json --noEmit", "test": "npm run build && node --test dist/*.test.js", "dev": "node --watch --import tsx src/index.ts", "start": "node dist/index.js", "migrate": "node --import tsx src/migrate.ts up", "migrate:check": "node --import tsx src/migrate.ts check", "migrate:baseline": "node --import tsx src/migrate.ts baseline", "test:postgres": "npm run build && node --import tsx src/test-postgres.ts", "worker:outbox": "node --import tsx src/outbox-worker.ts", "test:loadtest:seed": "node --import tsx src/loadtest-seed.ts", "test:loadtest:verify": "node --import tsx src/loadtest-verify.ts"},
  "dependencies": {"@kingdoms/shared": "0.1.0", "@fastify/cors": "^10.0.1", "fastify": "^5.1.0", "pg": "^8.13.1", "prom-client": "^15.1.3", "redis": "^4.7.0", "ws": "^8.18.0", "zod": "^3.23.8"},
  "devDependencies": {"@types/node": "^22.10.2", "@types/pg": "^8.11.10", "@types/ws": "^8.5.13", "tsx": "^4.19.2", "typescript": "^5.7.2"}
}


