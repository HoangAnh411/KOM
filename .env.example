PORT=3000
DATABASE_URL=postgres://kingdoms:kingdoms@localhost:5432/kingdoms
REDIS_URL=redis://localhost:6379
SEASON_DURATION_MS=1209600000
ADMIN_TOKEN=
METRICS_TOKEN=
AUTH_MODE=dev
CLIENT_ORIGIN=http://localhost:5173
# Proxy hops in front of the server, because `request.ip` is what every IP-keyed rate
# limit counts. `false` = no proxy. `true` = one (same as `1`), which is the prod compose
# behind Caddy. Set the real count if you add a load balancer in front of Caddy: too high
# and clients can spoof X-Forwarded-For past the limits, too low and every player shares
# the proxy's own address and therefore one limit bucket.
TRUST_PROXY=false
ALLIANCE_LEADER_TERM_MS=604800000
WORLD_EVENT_SPAWN_CHANCE=0.0016666666666666668
WORLD_EVENT_TYPE=
VITE_API_URL=http://localhost:3000
VITE_AUTH_MODE=dev

# Outbox worker (optional; defaults shown). Unused in dev but documented
# because they are part of the production deployment from day one.
OUTBOX_METRICS_PORT=9101
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_MS=500