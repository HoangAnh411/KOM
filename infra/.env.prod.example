# Copy to .env.prod at the repository root and fill in real secrets. Never commit .env.prod.
# All values are required by docker-compose.prod.yml or the production config gate.

POSTGRES_DB=kingdoms
POSTGRES_USER=kingdoms
POSTGRES_PASSWORD=change-me-at-least-32-chars

# Public site address, e.g. play.example.com. Offline smoke uses
# infra/docker-compose.smoke.yml with SITE_ADDRESS=localhost:8081 and SMOKE_PORT.
SITE_ADDRESS=play.example.com

# Game server configuration (production gates enforce these)
ADMIN_TOKEN=change-me-at-least-32-chars
METRICS_TOKEN=change-me-at-least-32-chars
CLIENT_ORIGIN=https://play.example.com
SEASON_DURATION_MS=1209600000
ALLIANCE_LEADER_TERM_MS=604800000
WORLD_EVENT_SPAWN_CHANCE=0.0016666666666666668
WORLD_EVENT_TYPE=

GRAFANA_ADMIN_PASSWORD=change-me
